{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Planner",
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "Planner": {
      "model": "opencode-go/glm-5.3"
    },
    "Builder": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "chrome-devtools_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "browse_*",
          "resource": "*",
          "effect": "allow"
        }
      ],
      "mode": "subagent"
    },
    "general": {
      "model": "opencode-go/glm-5.3",
      "mode": "subagent"
    },
    "Reviewer": {
      "model": "opencode-go/glm-5.3"
    },
    "title": {
      "model": "opencode-go/glm-5.3",
      "mode": "primary"
    },
    "summary": {
      "model": "opencode-go/glm-5.3",
      "mode": "primary"
    },
    "compaction": {
      "model": "opencode/deepseek-v4.1-flash-free",
      "mode": "primary"
    }
  },
  "websearch": {
    "provider": "random"
  },
  "experimental": {
    "subagent_depth": 2,
    "todo": true,
    "background_compaction": true
  },
  "mcp": {
    "servers": {
      "mermaid-chart": {
        "type": "remote",
        "url": "https://chatgpt.mermaid.ai/anthropic/mcp",
        "disabled": false
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": false
      },
      "netlify": {
        "type": "remote",
        "url": "https://netlify-mcp.netlify.app/mcp",
        "disabled": false
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp",
        "disabled": false
      },
      "gitbook": {
        "type": "remote",
        "url": "https://mcp.gitbook.com/mcp",
        "disabled": false
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/grumpy/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/home/grumpy",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf*",
      "effect": "ask"
    }
  ]
}
